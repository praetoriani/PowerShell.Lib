<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModernUI v1.00.00"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Width="800"
        Height="600"
        x:Name="ModernUIWindow">

    <Window.Resources>
        <!-- Close Button Style - No default hover effects -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Remove default hover effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Image Layer -->
        <Image x:Name="BackgroundImage" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Stretch" 
               VerticalAlignment="Stretch"/>

        <!-- Main Content Container -->
        <DockPanel LastChildFill="True">
            <!-- ActionBar / TitleBar -->
            <Border x:Name="TitleBar"
                    DockPanel.Dock="Top" 
                    Height="36" 
                    Background="#00000000"
                    Cursor="Hand">
                <Grid>
                    <!-- Icon -->
                    <Image x:Name="AppIcon" 
                           Width="24" 
                           Height="24" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="8,0,0,0" 
                           Stretch="UniformToFill"/>

                    <!-- Title Text -->
                    <TextBlock x:Name="TitleText" 
                               Text="ModernUI v1.00.00" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               Foreground="#FFFFFF" 
                               FontWeight="Normal"
                               IsHitTestVisible="False"/>

                    <!-- Close Button -->
                    <Button x:Name="CloseButton" 
                            Style="{StaticResource CloseButtonStyle}"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center" 
                            Width="36" 
                            Height="36" 
                            Margin="0,0,0,0" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            Padding="6">
                        <Image x:Name="CloseButtonImage" 
                               Width="24" 
                               Height="24" 
                               Stretch="UniformToFill"
                               IsHitTestVisible="False"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border DockPanel.Dock="Top" Background="Transparent" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Margin="20">
                    <TextBlock Text="ModernUI Framework" 
                               FontFamily="Segoe UI" 
                               FontSize="28" 
                               Foreground="#FFFFFF" 
                               FontWeight="Bold" 
                               TextAlignment="Center" 
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Frameless Window with PNG Background" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               Foreground="#CCCCCC" 
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>