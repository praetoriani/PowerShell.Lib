<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ModernUI"
    Width="800"
    Height="600"
    MinWidth="640"
    MinHeight="480"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <!-- =================================================================
         ModernXUI2.xaml
         Das originale ModernUI Look&Feel - vollstaendig in XAML.
         Kein PNG fuer den Fensterhintergrund benoetigt.

         Design-Elemente (1:1 Nachbau von ModernUI-WinBG / ModernUI-Preview):
           - Dunkles Fenster mit LinearGradientBrush (kein PNG)
           - Abgerundete Ecken via CornerRadius + ClipToBounds
           - Ausserer DropShadowEffect (ersetzt PNG-Schatten)
           - Schmale dunklere Titelleiste mit dezenter Trennlinie
           - Icon-Platzhalter links + Titel + Version in Titelleiste
           - Windows-native Fenstersteuerung rechts (X-Button)
           - Zentrierter Haupt-Titel + Versions-Text im Content-Bereich
           - Eingebetteter Preview-Bereich (AppScreenBorder)
           - Credits-Bereich unten
           - Sanfte Einblend-Animation beim Start

         Verwendung:
           $window = [System.Windows.Markup.XamlReader]::Load(
               [System.Xml.XmlNodeReader]::new([xml](Get-Content '.\WPF\ModernXUI2.xaml' -Raw))
           )
    ================================================================== -->

    <Window.Resources>

        <!-- Farbpalette -->
        <Color x:Key="ColWinBgTop">#FF232323</Color>
        <Color x:Key="ColWinBgMid">#FF1E1E1E</Color>
        <Color x:Key="ColWinBgBot">#FF181818</Color>
        <Color x:Key="ColTitleBgTop">#FF2C2C2C</Color>
        <Color x:Key="ColTitleBgBot">#FF242424</Color>
        <Color x:Key="ColTitleSep">#FF383838</Color>
        <Color x:Key="ColTextWhite">#FFFFFFFF</Color>
        <Color x:Key="ColTextSilver">#FFCCCCCC</Color>
        <Color x:Key="ColTextGray">#FFB0BEC5</Color>
        <Color x:Key="ColTextFaint">#FF777777</Color>
        <Color x:Key="ColAccent">#FF00BFA5</Color>
        <Color x:Key="ColAccentDim">#3300BFA5</Color>
        <Color x:Key="ColPreviewBg">#FF1A1A1A</Color>
        <Color x:Key="ColPreviewBorder">#FF333333</Color>
        <Color x:Key="ColCloseHover">#FFE53935</Color>
        <Color x:Key="ColBtnHover">#FF3A3A3A</Color>

        <!-- Pinsel -->
        <SolidColorBrush x:Key="BrushTextWhite"   Color="{StaticResource ColTextWhite}" />
        <SolidColorBrush x:Key="BrushTextSilver"  Color="{StaticResource ColTextSilver}" />
        <SolidColorBrush x:Key="BrushTextGray"    Color="{StaticResource ColTextGray}" />
        <SolidColorBrush x:Key="BrushTextFaint"   Color="{StaticResource ColTextFaint}" />
        <SolidColorBrush x:Key="BrushAccent"      Color="{StaticResource ColAccent}" />
        <SolidColorBrush x:Key="BrushPreviewBg"   Color="{StaticResource ColPreviewBg}" />
        <SolidColorBrush x:Key="BrushPreviewBdr"  Color="{StaticResource ColPreviewBorder}" />

        <!-- Fenster-Hintergrundverlauf (ersetzt ModernUI-WinBG.png) -->
        <LinearGradientBrush x:Key="BrushWindowBg"
                             StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="{StaticResource ColWinBgTop}" Offset="0.0"/>
            <GradientStop Color="{StaticResource ColWinBgMid}" Offset="0.5"/>
            <GradientStop Color="{StaticResource ColWinBgBot}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Titelleisten-Verlauf -->
        <LinearGradientBrush x:Key="BrushTitleBg"
                             StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource ColTitleBgTop}" Offset="0.0"/>
            <GradientStop Color="{StaticResource ColTitleBgBot}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Akzentlinie oben (schmaler Teal-Glow) -->
        <LinearGradientBrush x:Key="BrushTopAccent"
                             StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Transparent"                      Offset="0.0"/>
            <GradientStop Color="{StaticResource ColAccentDim}"    Offset="0.15"/>
            <GradientStop Color="{StaticResource ColAccent}"       Offset="0.5"/>
            <GradientStop Color="{StaticResource ColAccentDim}"    Offset="0.85"/>
            <GradientStop Color="Transparent"                      Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Einblend-Animation -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation
                Storyboard.TargetName="RootScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.96" To="1.0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="RootScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.96" To="1.0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="RootBorder"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Style: Titelleisten-Button (X schliessen) -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{StaticResource BrushTextSilver}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI Symbol"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BG"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BG" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource ColBtnHover}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BG" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Schliessen-Button (roter Hover) -->
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BG"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BG" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource ColCloseHover}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BG" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SVG-artiges App-Icon als Path (ersetzt WindowIcon.png) -->
        <!-- Einfaches Terminal/Shell Symbol -->
        <Style x:Key="AppIconStyle" TargetType="Path">
            <Setter Property="Fill"              Value="{StaticResource BrushTextSilver}"/>
            <Setter Property="Width"             Value="18"/>
            <Setter Property="Height"            Value="18"/>
            <Setter Property="Stretch"           Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- Animations-Trigger -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- Aeusserer Wrapper mit Schatten-Margin -->
    <Grid Margin="14">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale"
                            ScaleX="0.96" ScaleY="0.96"
                            CenterX="400" CenterY="300"/>
        </Grid.RenderTransform>

        <!-- Schatten-Layer (ersetzt den PNG-Schatten) -->
        <Border CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0"
                                  BlurRadius="32"
                                  Opacity="0.90"
                                  Color="#FF000000"/>
            </Border.Effect>
            <Border Background="#FF181818" CornerRadius="14"/>
        </Border>

        <!-- Haupt-Fensterrahmen -->
        <Border x:Name="RootBorder"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="#FF3A3A3A"
                ClipToBounds="True"
                Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FF232323" Offset="0.0"/>
                    <GradientStop Color="#FF1E1E1E" Offset="0.4"/>
                    <GradientStop Color="#FF1A1A1A" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Teal-Akzentlinie oben -->
                    <RowDefinition Height="2"/>
                    <!-- Titelleiste -->
                    <RowDefinition Height="40"/>
                    <!-- Trennlinie -->
                    <RowDefinition Height="1"/>
                    <!-- Inhaltsbereich -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ZEILE 0: Akzentlinie (ModernUI-Markenzeichen oben) -->
                <Rectangle Grid.Row="0"
                           Fill="{StaticResource BrushTopAccent}"/>

                <!-- ZEILE 1: Titelleiste -->
                <Border Grid.Row="1"
                        Background="{StaticResource BrushTitleBg}">
                    <Grid x:Name="TitleBarPanel">
                        <Grid.ColumnDefinitions>
                            <!-- Icon + Titel -->
                            <ColumnDefinition Width="*"/>
                            <!-- Fenstersteuerung -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Linke Seite: Icon + App-Name + Version -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">

                            <!-- App-Icon (Terminal/Shell Symbol als Vektor) -->
                            <Border Width="22" Height="22"
                                    Background="#FF2E2E2E"
                                    CornerRadius="4"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <!-- Prompt-Pfeil -->
                                    <Path Data="M3,5 L9,5 M3,8 L12,8 M3,11 L7,11"
                                          Stroke="#FF00BFA5"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="14" Height="10"
                                          Stretch="Uniform"/>
                                </Grid>
                            </Border>

                            <!-- App-Name -->
                            <TextBlock x:Name="TitleText"
                                       Text="ModernUI"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextWhite}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text=" "
                                       FontSize="14"
                                       VerticalAlignment="Center"/>

                            <!-- Version -->
                            <TextBlock x:Name="VersionText"
                                       Text="v1.00.02"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextSilver}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Rechte Seite: Fenstersteuerung -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Stretch">

                            <!-- Minimieren -->
                            <Button x:Name="BtnMinimize"
                                    Style="{StaticResource TitleBarBtn}"
                                    ToolTip="Minimieren">
                                <TextBlock Text="&#x2014;"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource BrushTextSilver}"/>
                            </Button>

                            <!-- Maximieren -->
                            <Button x:Name="BtnMaximize"
                                    Style="{StaticResource TitleBarBtn}"
                                    ToolTip="Maximieren">
                                <Border Width="11" Height="11"
                                        BorderBrush="{StaticResource BrushTextSilver}"
                                        BorderThickness="1.5"
                                        CornerRadius="1"
                                        Background="Transparent"/>
                            </Button>

                            <!-- Schliessen -->
                            <Button x:Name="BtnClose"
                                    Style="{StaticResource CloseBtn}"
                                    ToolTip="Schliessen">
                                <Path Data="M0,0 L8,8 M8,0 L0,8"
                                      Stroke="{StaticResource BrushTextSilver}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="9" Height="9"
                                      Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ZEILE 2: Trennlinie -->
                <Rectangle Grid.Row="2" Fill="#FF383838"/>

                <!-- ZEILE 3: INHALTSBEREICH -->
                <Grid Grid.Row="3">

                    <!-- Inhalts-ScrollViewer fuer Flexibilitaet -->
                    <ScrollViewer VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="40,32,40,32">

                            <!-- Haupt-Titel (gross, weiss, zentriert) -->
                            <TextBlock x:Name="MainTitleText"
                                       Text="ModernUI"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextWhite}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <!-- Versions-Anzeige -->
                            <TextBlock x:Name="MainVersionText"
                                       Text="v1.00.02"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSilver}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,24"/>

                            <!-- Preview/Screenshot-Bereich -->
                            <Border x:Name="AppScreenBorder"
                                    Background="{StaticResource BrushPreviewBg}"
                                    BorderBrush="{StaticResource BrushPreviewBdr}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,0,0,24"
                                    HorizontalAlignment="Center"
                                    Width="520">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0"
                                                      BlurRadius="16"
                                                      Opacity="0.5"
                                                      Color="#FF000000"/>
                                </Border.Effect>

                                <!-- Innerer Preview-Bereich -->
                                <Grid Height="220">

                                    <!-- Placeholder wenn kein Bild gesetzt wird -->
                                    <!-- Per PowerShell kann hier ein Image-Element
                                         via FindName('AppScreenImage') gesetzt werden -->
                                    <Image x:Name="AppScreenImage"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                    <!-- Fallback-Anzeige wenn kein Bild vorhanden -->
                                    <StackPanel x:Name="AppScreenPlaceholder"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <!-- Dekoratives Terminal-Symbol -->
                                        <Border Width="56" Height="56"
                                                Background="#FF252525"
                                                CornerRadius="10"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,12">
                                            <Grid HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Path Data="M4,4 L10,10 L4,16"
                                                      Stroke="#FF00BFA5"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="16" Height="16"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="AppScreenImage"
                                                   FontSize="11"
                                                   Foreground="#FF555555"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="Bild per PowerShell setzen"
                                                   FontSize="10"
                                                   Foreground="#FF444444"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Credits: Autor -->
                            <TextBlock Text="Written by Praetoriani"
                                       FontSize="14"
                                       Foreground="{StaticResource BrushTextWhite}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>

                            <!-- Credits: GitHub -->
                            <TextBlock Text="Now available on GitHub"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextGray}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,0"/>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
                <!-- Ende ZEILE 3 -->

            </Grid>
        </Border>
        <!-- Ende Haupt-Fensterrahmen -->

    </Grid>
</Window>
