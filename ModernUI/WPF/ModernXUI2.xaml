<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ModernUI"
    Height="600"
    Width="800"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    x:Name="MainWindow">

    <!--
    =======================================================================
    ModernXUI2.xaml
    Pixelgenaue XAML-Nachbildung des originalen ModernUI-WinBG.png Designs.
    Kein PNG fuer den Fensterhintergrund benoetigt.

    Farben (exakt aus ModernUI-WinBG.png abgelesen):
      Fenster-BG:       #3C3C3C  (mittleres Dunkelgrau)
      Titelleiste:      #2E2E2E  (leicht dunkler als BG)
      Trennlinie:       #282828  (1px, dunkelgrau)
      Fensterrand:      #282828  (1px Border)
      Text weiss:       #FFFFFF
      Text silber:      #CCCCCC
      Text grau:        #B0BEC5
      Preview-BG:       #1E1E1E
      Preview-Border:   #333333
      Schatten:         #000000  (weicher DropShadow, ShadowDepth=0)

    Verwendung (in PowerShell):
      Add-Type -AssemblyName PresentationFramework
      $xaml = [xml](Get-Content '.\WPF\ModernXUI2.xaml' -Raw)
      $reader = [System.Xml.XmlNodeReader]::new($xaml)
      $window = [System.Windows.Markup.XamlReader]::Load($reader)

      # Elemente per FindName() ansprechen:
      $window.FindName('TitleText').Text    = 'MeinTool'
      $window.FindName('VersionText').Text  = 'v2.0.0'
      $window.FindName('MainTitleText').Text   = 'MeinTool'
      $window.FindName('MainVersionText').Text = 'v2.0.0'
      $img = [System.Windows.Media.Imaging.BitmapImage]::new(
          [Uri]::new((Resolve-Path '.\PNG\appscreen.png'))
      )
      $window.FindName('AppScreenImage').Source = $img

      # Fenster verschieben (Titelleiste draggable machen):
      $window.FindName('TitleBar').Add_MouseLeftButtonDown({
          $window.DragMove()
      })

      # Buttons verdrahten:
      $window.FindName('CloseButton').Add_Click({ $window.Close() })

      $window.ShowDialog()
    =======================================================================
    -->

    <Window.Resources>

        <!-- ===============================================================
             FARBDEFINITIONEN
             Exakt aus ModernUI-WinBG.png abgelesen.
        =============================================================== -->

        <!-- Fenster-Hintergrund: mittleres Dunkelgrau (das praegnante ModernUI-Grau) -->
        <SolidColorBrush x:Key="BrushWinBg"       Color="#FF3C3C3C"/>
        <!-- Titelleiste: etwas dunkler als der BG -->
        <SolidColorBrush x:Key="BrushTitleBg"     Color="#FF2E2E2E"/>
        <!-- Trennlinie zwischen Titelleiste und Content -->
        <SolidColorBrush x:Key="BrushSeparator"   Color="#FF282828"/>
        <!-- Ausserer Fensterrand (1px) -->
        <SolidColorBrush x:Key="BrushWinBorder"   Color="#FF282828"/>

        <!-- Texte -->
        <SolidColorBrush x:Key="BrushTextWhite"   Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="BrushTextSilver"  Color="#FFCCCCCC"/>
        <SolidColorBrush x:Key="BrushTextGray"    Color="#FFB0BEC5"/>

        <!-- Preview-Bereich -->
        <SolidColorBrush x:Key="BrushPreviewBg"   Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="BrushPreviewBdr"  Color="#FF333333"/>

        <!-- Hover-Farben fuer Titelleisten-Buttons -->
        <SolidColorBrush x:Key="BrushBtnHover"    Color="#FF4A4A4A"/>
        <SolidColorBrush x:Key="BrushCloseHover"  Color="#FFE53935"/>

        <!-- ===============================================================
             EINBLEND-ANIMATION (Fade-In beim Laden)
        =============================================================== -->
        <Storyboard x:Key="FadeInAnim">
            <DoubleAnimation
                Storyboard.TargetName="MainBorder"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0"
                Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ===============================================================
             STYLE: Titelleisten-Label-Button
             Identisch zur Original-Implementierung: Label mit Image-Content.
             Hover-Effekt via ControlTemplate-Trigger.
        =============================================================== -->
        <Style x:Key="TitleLabelBtn" TargetType="Label">
            <Setter Property="Width"                    Value="24"/>
            <Setter Property="Height"                   Value="24"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Padding"                  Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border x:Name="BtnBG"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBG" Property="Background"
                                        Value="{StaticResource BrushBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Schliessen-Label-Button (roter Hover) -->
        <Style x:Key="CloseLabelBtn" TargetType="Label"
               BasedOn="{StaticResource TitleLabelBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border x:Name="BtnBG"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBG" Property="Background"
                                        Value="{StaticResource BrushCloseHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Animations-Trigger beim Laden des Fensters -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnim}"/>
        </EventTrigger>
    </Window.Triggers>

    <!--
    =======================================================================
    LAYOUT-STRUKTUR
    Margin="12" schafft Platz fuer den weichen Schatten aussen.
    =======================================================================
    -->
    <Grid Margin="12">

        <!-- SCHATTEN-LAYER:
             Separater Border hinter dem Hauptfenster.
             ShadowDepth=0 + grosser BlurRadius = weicher Glow-Schatten
             wie beim originalen ModernUI-WinBG.png. -->
        <Border CornerRadius="10" Background="#FF3C3C3C">
            <Border.Effect>
                <DropShadowEffect
                    ShadowDepth="0"
                    BlurRadius="20"
                    Opacity="0.85"
                    Color="#FF000000"/>
            </Border.Effect>
        </Border>

        <!-- HAUPT-FENSTERRAHMEN:
             CornerRadius="10" + ClipToBounds="True" = abgerundete Ecken.
             BorderBrush="#FF282828" = der 1px dunkle Rand aus der PNG.
             Opacity startet bei 0, wird per FadeInAnim auf 1 animiert. -->
        <Border x:Name="MainBorder"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{StaticResource BrushWinBorder}"
                Background="{StaticResource BrushWinBg}"
                ClipToBounds="True"
                Opacity="0">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Titelleiste: 40px (identisch zu ModernUI.xaml) -->
                    <RowDefinition Height="40"/>
                    <!-- Trennlinie: 1px -->
                    <RowDefinition Height="1"/>
                    <!-- Inhaltsbereich: Rest -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- =======================================================
                     ZEILE 0: TITELLEISTE
                     Aufbau 1:1 wie ModernUI.xaml:
                       Col 0 (Auto): WindowIcon (24x24)
                       Col 1 (*):    TitleText + VersionText
                       Col 2 (Auto): CloseButton (Label mit Image)
                ======================================================= -->
                <Border Grid.Row="0"
                        Background="{StaticResource BrushTitleBg}">
                    <Grid x:Name="TitleBar">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon links (24x24, per PowerShell befuellbar) -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <Image x:Name="WindowIcon"
                                   Width="24" Height="24"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- App-Name + Version (mitte-links) -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock x:Name="TitleText"
                                       Text="ModernUI"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextWhite}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" "
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionText"
                                       Text="v1.00.02"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextSilver}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Fenstersteuerung rechts -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <!-- Close-Button: Label mit Image (wie Original) -->
                            <Label x:Name="CloseButton"
                                   Style="{StaticResource CloseLabelBtn}">
                                <Image x:Name="CloseButtonImage"
                                       Width="24" Height="24"
                                       Stretch="Uniform"/>
                            </Label>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- =======================================================
                     ZEILE 1: TRENNLINIE (1px)
                ======================================================= -->
                <Rectangle Grid.Row="1"
                            Fill="{StaticResource BrushSeparator}"/>

                <!-- =======================================================
                     ZEILE 2: INHALTSBEREICH
                     Identisch zu ModernUI.xaml:
                       - Grosser Titel (32px, Bold, weiss)
                       - Versions-Text (20px, SemiBold, hellgrau)
                       - AppScreenImage in dunkel abgesetztem Border
                       - Credits unten
                ======================================================= -->
                <Grid Grid.Row="2" Background="Transparent">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="40">

                        <!-- Haupt-Titel -->
                        <TextBlock x:Name="MainTitleText"
                                   Text="ModernUI"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextWhite}"
                                   TextAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <!-- Versions-Text -->
                        <TextBlock x:Name="MainVersionText"
                                   Text="v1.00.02"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextSilver}"
                                   TextAlignment="Center"
                                   Margin="0,0,0,24"/>

                        <!-- App-Screenshot / Preview-Bild -->
                        <Border Background="{StaticResource BrushPreviewBg}"
                                BorderBrush="{StaticResource BrushPreviewBdr}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Margin="0,0,0,24"
                                Opacity="0.95">
                            <Image x:Name="AppScreenImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Height="260"/>
                        </Border>

                        <!-- Credits: Autor -->
                        <TextBlock Text="Written by Praetoriani"
                                   FontSize="14"
                                   Foreground="{StaticResource BrushTextWhite}"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <!-- Credits: GitHub -->
                        <TextBlock Text="Now available on GitHub"
                                   FontSize="13"
                                   Foreground="{StaticResource BrushTextGray}"
                                   TextAlignment="Center"/>

                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
        <!-- Ende MainBorder -->

    </Grid>
</Window>
