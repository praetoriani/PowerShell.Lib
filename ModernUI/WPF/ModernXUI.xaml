<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ModernUI - XML-Design Demo"
    Width="820"
    Height="560"
    MinWidth="640"
    MinHeight="420"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <!-- =================================================================
         RESSOURCEN - Farben, Pinsel, Stile, Animationen
         (Das ist das Herzstuck: alles was fruher PNG war, steht hier)
    ================================================================== -->
    <Window.Resources>

        <!-- Farbpalette -->
        <Color x:Key="ColWindowBgTop">#FF2A2A2A</Color>
        <Color x:Key="ColWindowBgBot">#FF1A1A1A</Color>
        <Color x:Key="ColAccentTeal">#FF00BFA5</Color>
        <Color x:Key="ColAccentTealDark">#FF00897B</Color>
        <Color x:Key="ColAccentTealGlow">#4400BFA5</Color>
        <Color x:Key="ColSurface">#FF2E2E2E</Color>
        <Color x:Key="ColSurface2">#FF363636</Color>
        <Color x:Key="ColBorder">#FF444444</Color>
        <Color x:Key="ColTextPrimary">#FFDDDDDD</Color>
        <Color x:Key="ColTextMuted">#FF888888</Color>
        <Color x:Key="ColTextFaint">#FF555555</Color>
        <Color x:Key="ColBtnClose">#FFFF5F57</Color>
        <Color x:Key="ColBtnMinimize">#FFFFBD2E</Color>
        <Color x:Key="ColBtnMaximize">#FF28C840</Color>
        <Color x:Key="ColBtnDark">#FF3A3A3A</Color>

        <!-- Pinsel -->
        <SolidColorBrush x:Key="BrushAccent"      Color="{StaticResource ColAccentTeal}" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColTextPrimary}" />
        <SolidColorBrush x:Key="BrushTextMuted"   Color="{StaticResource ColTextMuted}" />
        <SolidColorBrush x:Key="BrushTextFaint"   Color="{StaticResource ColTextFaint}" />
        <SolidColorBrush x:Key="BrushBorder"      Color="{StaticResource ColBorder}" />
        <SolidColorBrush x:Key="BrushSurface"     Color="{StaticResource ColSurface}" />
        <SolidColorBrush x:Key="BrushSurface2"    Color="{StaticResource ColSurface2}" />
        <SolidColorBrush x:Key="BrushBtnClose"    Color="{StaticResource ColBtnClose}" />
        <SolidColorBrush x:Key="BrushBtnMin"      Color="{StaticResource ColBtnMinimize}" />
        <SolidColorBrush x:Key="BrushBtnMax"      Color="{StaticResource ColBtnMaximize}" />
        <SolidColorBrush x:Key="BrushBtnDark"     Color="{StaticResource ColBtnDark}" />

        <!-- Hauptfenster-Hintergrundverlauf (ersetzt die PNG!) -->
        <LinearGradientBrush x:Key="BrushWindowBg"
                             StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="{StaticResource ColWindowBgTop}" Offset="0.0"/>
            <GradientStop Color="{StaticResource ColWindowBgBot}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Titelleisten-Hintergrundverlauf -->
        <LinearGradientBrush x:Key="BrushTitleBar"
                             StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF282828" Offset="0.0"/>
            <GradientStop Color="#FF1E1E1E" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Akzentlinie oben (Teal-Gluhen - das ModernUI-Markenzeichen) -->
        <LinearGradientBrush x:Key="BrushAccentBar"
                             StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Transparent"                        Offset="0.0"/>
            <GradientStop Color="{StaticResource ColAccentTealGlow}" Offset="0.2"/>
            <GradientStop Color="{StaticResource ColAccentTeal}"     Offset="0.5"/>
            <GradientStop Color="{StaticResource ColAccentTealGlow}" Offset="0.8"/>
            <GradientStop Color="Transparent"                        Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Statusleisten-Hintergrundverlauf -->
        <LinearGradientBrush x:Key="BrushStatusBar"
                             StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF1C1C1C" Offset="0.0"/>
            <GradientStop Color="#FF181818" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Einblend-Animation (Fade + Scale beim Start) -->
        <Storyboard x:Key="WindowAppear">
            <DoubleAnimation
                Storyboard.TargetName="WindowScaleTransform"
                Storyboard.TargetProperty="ScaleX"
                From="0.94" To="1.0" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="WindowScaleTransform"
                Storyboard.TargetProperty="ScaleY"
                From="0.94" To="1.0" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="RootBorder"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Style: Traffic-Light Button -->
        <Style x:Key="TrafficLightBtn" TargetType="Button">
            <Setter Property="Width"  Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Circle"
                                 Width="14" Height="14"
                                 Fill="{TemplateBinding Background}">
                            <Ellipse.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.5"
                                    Color="{Binding Background.Color,
                                            RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Primar-Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"     Value="34"/>
            <Setter Property="Padding"    Value="20,0"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BG"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BG" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource ColAccentTealDark}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BG" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Ghost-Button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BG"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BG" Property="Background"
                                        Value="{StaticResource BrushSurface2}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BG" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Info-Karte -->
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16"/>
        </Style>

        <!-- Style: Trennlinie -->
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height"  Value="1"/>
            <Setter Property="Fill"    Value="{StaticResource BrushBorder}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

    </Window.Resources>

    <!-- Animations-Trigger: Einblenden beim Laden -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowAppear}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- Schatten-Wrapper -->
    <Grid Margin="12">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="WindowScaleTransform"
                            ScaleX="0.94" ScaleY="0.94"
                            CenterX="410" CenterY="280"/>
        </Grid.RenderTransform>

        <!-- Ausserer Schatten-Border (ersetzt den PNG-Schatten) -->
        <Border CornerRadius="12" Opacity="0.6">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="28" Opacity="0.85" Color="#FF000000"/>
            </Border.Effect>
            <Border Background="#FF1A1A1A" CornerRadius="12"/>
        </Border>

        <!-- Haupt-Fensterrahmen -->
        <Border x:Name="RootBorder"
                Background="{StaticResource BrushWindowBg}"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="#FF404040"
                ClipToBounds="True"
                Opacity="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- ZEILE 0: Teal-Akzentlinie -->
                <Rectangle Grid.Row="0"
                           Fill="{StaticResource BrushAccentBar}"
                           RadiusX="12" RadiusY="12"/>

                <!-- ZEILE 1: Titelleiste -->
                <Grid Grid.Row="1"
                      x:Name="TitleBarPanel"
                      Background="{StaticResource BrushTitleBar}"
                      Cursor="Arrow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Traffic-Light Buttons -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Button x:Name="BtnClose"
                                Style="{StaticResource TrafficLightBtn}"
                                Background="{StaticResource BrushBtnClose}"
                                ToolTip="Schliessen"/>
                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource TrafficLightBtn}"
                                Background="{StaticResource BrushBtnMin}"
                                ToolTip="Minimieren"/>
                        <Button x:Name="BtnMaximize"
                                Style="{StaticResource TrafficLightBtn}"
                                Background="{StaticResource BrushBtnMax}"
                                ToolTip="Maximieren"/>
                    </StackPanel>

                    <!-- Fenster-Titel -->
                    <TextBlock Grid.Column="1"
                               x:Name="TitleBarText"
                               Text="ModernUI - XML-Design Demo"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ZEILE 2: Trennlinie unter Titelleiste -->
                <Rectangle Grid.Row="2" Style="{StaticResource Divider}"/>

                <!-- ZEILE 3: INHALTSBEREICH -->
                <Grid Grid.Row="3" Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- App-Name + Version Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="28"
                                Background="{StaticResource BrushAccent}"
                                CornerRadius="2"
                                Margin="0,0,12,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Text="ModernUI"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock x:Name="VersionText"
                                       Text="v2.0.0"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushAccent}"
                                       VerticalAlignment="Bottom"
                                       Margin="8,0,0,2"/>
                        </StackPanel>
                        <TextBlock Text="XML-Edition"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextFaint}"
                                   VerticalAlignment="Bottom"
                                   Margin="10,0,0,3"/>
                    </StackPanel>

                    <TextBlock Grid.Row="0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Text="Vollstandig in XAML definiert - kein einziges PNG"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextFaint}"/>

                    <!-- Info-Karten: 3-spaltig -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Karte 1: Design -->
                        <Border Grid.Column="0" Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="DESIGN"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushAccent}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Dunkel - Stylisch - Modern"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Abgerundete Ecken, Teal-Akzente und subtile Verlaufe - alles definiert im XAML."
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Karte 2: Architektur -->
                        <Border Grid.Column="2" Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="ARCHITEKTUR"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushAccent}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="XAML-only UI"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Die gesamte UI-Definition liegt in WPF\ModernXUI.xaml. PowerShell ubernimmt nur noch Logik."
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Karte 3: Vorteile -->
                        <Border Grid.Column="4" Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="VORTEILE"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushAccent}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Flexible Grosse"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Frei skalierbar, keine fixen PNG-Grossen. Echtzeit-Animationen, DPI-skalierbar und responsive."
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Hauptbereich: Demo-Content -->
                    <Border Grid.Row="4" Style="{StaticResource InfoCard}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Das Konzept im Vergleich"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}"/>

                            <Rectangle Grid.Row="1" Style="{StaticResource Divider}" Margin="0,5,0,0"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ModernUI v1 (alt) -->
                                <StackPanel Grid.Column="0" Margin="0,8,0,0">
                                    <TextBlock Text="ModernUI v1  -  PNG-Edition"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="6" Height="6" Fill="#FF555555"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Fenster via PNG-Hintergrund"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextFaint}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="6" Height="6" Fill="#FF555555"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Fixe Fenstergrosse durch PNG"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextFaint}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="6" Height="6" Fill="#FF555555"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Schatten aus Grafik-Datei"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextFaint}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="6" Height="6" Fill="#FF555555"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Keine nativen WPF-Animationen"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextFaint}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Trennlinie vertikal -->
                                <Rectangle Grid.Column="1"
                                           Width="1"
                                           Fill="{StaticResource BrushBorder}"
                                           Opacity="0.4"
                                           HorizontalAlignment="Center"/>

                                <!-- ModernUI v2 (neu) -->
                                <StackPanel Grid.Column="2" Margin="0,8,0,0">
                                    <TextBlock Text="ModernUI v2  -  XML-Edition"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushAccent}"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{StaticResource BrushAccent}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Fenster via XAML LinearGradientBrush"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{StaticResource BrushAccent}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Frei skalierbar + ResizeMode"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{StaticResource BrushAccent}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="DropShadowEffect direkt in XAML"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{StaticResource BrushAccent}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Storyboard Fade-In beim Start"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Action-Buttons -->
                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Abbrechen"
                                Style="{StaticResource GhostBtn}"
                                Margin="0,0,10,0"
                                x:Name="BtnCancel"/>
                        <Button Content="Bestatigen"
                                Style="{StaticResource PrimaryBtn}"
                                x:Name="BtnConfirm"/>
                    </StackPanel>

                </Grid>

                <!-- ZEILE 4: Trennlinie uber Statusleiste -->
                <Rectangle Grid.Row="4" Style="{StaticResource Divider}"/>

                <!-- ZEILE 5: Statusleiste -->
                <Grid Grid.Row="5" Background="{StaticResource BrushStatusBar}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource BrushAccent}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Wird geladen..."
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextFaint}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="ModernUI XML-Edition  v2.0.0"
                               FontSize="10"
                               Foreground="{StaticResource BrushTextFaint}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
