<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ohne Speichern beenden?"
        Width="580"
        Height="300"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F2"
        Foreground="#134252"
        ShowInTaskbar="False"
        Topmost="True"
        x:Name="WarnWindow">
    
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#218014"/>
            <Setter Property="Foreground" Value="#FFFBFD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D7480"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A6C73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Message Container with Icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,15,0,25">
            <!-- Icon -->
            <TextBlock Text="!" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       Foreground="#A84B2F"
                       Width="50" 
                       Height="50"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Margin="0,0,20,0"/>
            
            <!-- Message Text -->
            <TextBlock Text="Es wurden Änderungen am Scanner-Profil vorgenommen. Diese Änderungen wurden noch nicht gespeichert. Wenn Sie das Programm jetzt beenden, gehen diese Änderungen verloren. Möchten Sie das Programm trotzdem beenden?"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#134252"
                       LineHeight="18"
                       VerticalAlignment="Top"/>
        </StackPanel>
        
        <!-- Button Container -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,25,0,0"
                    Height="Auto">
            <Button Style="{StaticResource DialogButton}" 
                    Content="Ja" 
                    Width="100" 
                    Margin="0,0,15,0"
                    x:Name="YesButton"/>
            <Button Style="{StaticResource DialogButton}" 
                    Content="Nein" 
                    Width="100"
                    x:Name="NoButton"/>
        </StackPanel>
    </Grid>
</Window>