<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ohne Speichern beenden?"
        Width="500"
        Height="220"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F2"
        Foreground="#134252"
        ShowInTaskbar="False"
        Topmost="True"
        x:Name="WarnWindow">
    
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#218014"/>
            <Setter Property="Foreground" Value="#FFFBFD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D7480"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A6C73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="DialogSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FAFAF8"/>
            <Setter Property="Foreground" Value="#134252"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#5E5240"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0ED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8E8E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Message Container with Icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,20">
            <!-- Icon -->
            <TextBlock Text="!" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#A84B2F"
                       Width="40" 
                       Height="40"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,20,0"/>
            
            <!-- Message Text -->
            <TextBlock Text="Es wurden Änderungen am Scanner-Profil vorgenommen. Diese Änderungen wurden noch nicht gespeichert. Wenn Sie das Programm jetzt beenden, gehen diese Änderungen verloren. Möchten Sie das Programm trotzdem beenden?"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#134252"
                       LineHeight="18"
                       VerticalAlignment="Top"/>
        </StackPanel>
        
        <!-- Button Container -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0"
                    Height="Auto">
            <Button Style="{StaticResource DialogButton}" 
                    Content="Ja" 
                    Width="80" 
                    Margin="0,0,10,0"
                    x:Name="YesButton"/>
            <Button Style="{StaticResource DialogSecondaryButton}" 
                    Content="Nein" 
                    Width="80"
                    x:Name="NoButton"/>
        </StackPanel>
    </Grid>
</Window>