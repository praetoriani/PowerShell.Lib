<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ohne Speichern beenden?"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F2"
        Foreground="#134252"
        ShowInTaskbar="False"
        Topmost="True"
        x:Name="WarnWindow">
    
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#616161"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#424242"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Message Container with Icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,14">
            <!-- Icon -->
            <TextBlock Text="!" 
                       FontSize="48" 
                       FontWeight="Bold" 
                       Foreground="#D97D2F"
                       Width="52" 
                       Height="52"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Margin="0,0,16,0"/>
            
            <!-- Message Text -->
            <TextBlock Text="Es wurden Änderungen am Scanner-Profil vorgenommen. Diese Änderungen wurden noch nicht gespeichert. Wenn Sie das Programm jetzt beenden, gehen diese Änderungen verloren. Möchten Sie das Programm trotzdem beenden?"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#134252"
                       LineHeight="21"
                       VerticalAlignment="Top"/>
        </StackPanel>
        
        <!-- Button Container -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,14,0,0"
                    Height="Auto">
            <Button Style="{StaticResource DialogButton}" 
                    Content="Ja" 
                    Width="110" 
                    Margin="0,0,16,0"
                    x:Name="YesButton"/>
            <Button Style="{StaticResource DialogButton}" 
                    Content="Nein" 
                    Width="110"
                    x:Name="NoButton"/>
        </StackPanel>
    </Grid>
</Window>