<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner-Profil konfigurieren"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F2"
        Foreground="#134252"
        x:Name="MainWindow">
    
    <Window.Resources>
        <Style x:Key="RoundedCornerBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#FFFBFD"/>
            <Setter Property="BorderBrush" Value="#5E5240"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#616161"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#424242"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#616161"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#424242"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="CustomCheckbox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Foreground" Value="#134252"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border CornerRadius="8" 
                                Padding="{TemplateBinding Padding}"
                                Background="#FFFBFD"
                                BorderBrush="#5E5240"
                                BorderThickness="1"
                                x:Name="border">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" 
                                        Width="24" 
                                        Height="24" 
                                        CornerRadius="4"
                                        Background="#FAFAF8"
                                        BorderBrush="#757575"
                                        BorderThickness="2"
                                        x:Name="checkBox"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="✓" 
                                             FontSize="16" 
                                             Foreground="#757575" 
                                             FontWeight="Bold"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             x:Name="checkMark"
                                             Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" 
                                                VerticalAlignment="Center" 
                                                Margin="14,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="border" Property="Background" Value="#E8F5F7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F8FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <TextBlock Grid.Row="0" 
                   Text="Scanner-Profil konfigurieren" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#134252" 
                   Margin="0,0,0,16"
                   x:Name="TitleBar"/>
        
        <!-- Instructions -->
        <TextBlock Grid.Row="1" 
                   Text="Bitte wählen Sie eine der unten stehenden Scanner-Profile aus und bestätigen Sie ihre Auswahl anschließend mit einem Klick auf den Speichern-Button" 
                   TextWrapping="Wrap" 
                   FontSize="14" 
                   Foreground="#5E5240" 
                   LineHeight="21"
                   Margin="0,0,0,28"/>
        
        <!-- Profile Selection Container -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,40">
            <!-- Standard Profile Checkbox -->
            <CheckBox Style="{StaticResource CustomCheckbox}"
                      Content="Standard-Profil (Scannt nur die Vorderseite)"
                      x:Name="StandardCheckbox"
                      IsChecked="False"/>
            
            <!-- Duplex Profile Checkbox -->
            <CheckBox Style="{StaticResource CustomCheckbox}"
                      Content="Duplex-Profil (Scannt Vorder- und Rückseite)"
                      x:Name="DuplexCheckbox"
                      IsChecked="False"/>
        </StackPanel>
        
        <!-- Button Container -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,10,0,0"
                    Height="44">
            <Button Style="{StaticResource PrimaryButton}" 
                    Content="Speichern" 
                    Width="150" 
                    Margin="0,0,24,0"
                    x:Name="SaveButton"/>
            <Button Style="{StaticResource SecondaryButton}" 
                    Content="Beenden" 
                    Width="150"
                    x:Name="CloseButton"/>
        </StackPanel>
    </Grid>
</Window>