<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner-Profil konfigurieren"
        Width="600"
        Height="420"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F2"
        Foreground="#134252"
        x:Name="MainWindow">
    
    <Window.Resources>
        <Style x:Key="RoundedCornerBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#FFFBFD"/>
            <Setter Property="BorderBrush" Value="#5E5240"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#218014"/>
            <Setter Property="Foreground" Value="#FFFBFD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D7480"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A6C73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#218014"/>
            <Setter Property="Foreground" Value="#FFFBFD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D7480"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A6C73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="CustomCheckbox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="#134252"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                Background="#FFFBFD"
                                BorderBrush="#5E5240"
                                BorderThickness="1"
                                x:Name="border">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" 
                                        Width="20" 
                                        Height="20" 
                                        CornerRadius="4"
                                        Background="#FAFAF8"
                                        BorderBrush="#218014"
                                        BorderThickness="2"
                                        x:Name="checkBox"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="u" 
                                             FontSize="14" 
                                             Foreground="#218014" 
                                             FontWeight="Bold"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             x:Name="checkMark"
                                             Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" 
                                                VerticalAlignment="Center" 
                                                Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="border" Property="Background" Value="#E8F5F7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F8FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <TextBlock Grid.Row="0" 
                   Text="Scanner-Profil konfigurieren" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#134252" 
                   Margin="0,0,0,15"
                   x:Name="TitleBar"/>
        
        <!-- Instructions -->
        <TextBlock Grid.Row="1" 
                   Text="Bitte wählen Sie eine der unten stehenden Scanner-Profile aus und bestätigen Sie ihre Auswahl anschließend mit einem Klick auf den Speichern-Button" 
                   TextWrapping="Wrap" 
                   FontSize="12" 
                   Foreground="#5E5240" 
                   LineHeight="18"
                   Margin="0,0,0,30"/>
        
        <!-- Profile Selection Container -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,40">
            <!-- Standard Profile Checkbox -->
            <CheckBox Style="{StaticResource CustomCheckbox}"
                      Content="Standard-Profil (Scannt nur die Vorderseite)"
                      x:Name="StandardCheckbox"
                      IsChecked="False"/>
            
            <!-- Duplex Profile Checkbox -->
            <CheckBox Style="{StaticResource CustomCheckbox}"
                      Content="Duplex-Profil (Scannt Vorder- und Rückseite)"
                      x:Name="DuplexCheckbox"
                      IsChecked="False"/>
        </StackPanel>
        
        <!-- Button Container -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,30,0,0"
                    Height="Auto"
                    Height="50">
            <Button Style="{StaticResource PrimaryButton}" 
                    Content="Speichern" 
                    Width="140" 
                    Margin="0,0,20,0"
                    x:Name="SaveButton"/>
            <Button Style="{StaticResource SecondaryButton}" 
                    Content="Beenden" 
                    Width="140"
                    x:Name="CloseButton"/>
        </StackPanel>
    </Grid>
</Window>