<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interner Fehler!"
        Width="500"
        Height="220"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F2"
        Foreground="#134252"
        ShowInTaskbar="False"
        Topmost="True"
        x:Name="ErrorWindow">
    
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#616161"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,0">
            <TextBlock Text="🛑" FontSize="52" FontWeight="Bold" Foreground="#C00F2F" Width="80" Height="80" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="16" Foreground="#134252" LineHeight="22" VerticalAlignment="Top" Margin="0,5,0,0" Text="Ein unerwarteter Laufzeit-Fehler ist aufgetreten.&#x0a;Der Fehler wurde im error.log protokolliert.&#x0a;Das Programm wird jetzt beendet."/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0" Height="Auto">
            <Button Style="{StaticResource DialogButton}" Content="OK" Width="110" x:Name="OkButton"/>
        </StackPanel>
    </Grid>
</Window>