<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Simple Form Demo" Height="420" Width="520"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="User Registration"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="First name:" Margin="0,0,0,4"/>
            <TextBox Margin="0,0,0,12" Padding="4"/>

            <TextBlock Text="Last name:" Margin="0,0,0,4"/>
            <TextBox Margin="0,0,0,12" Padding="4"/>

            <TextBlock Text="Email address:" Margin="0,0,0,4"/>
            <TextBox Margin="0,0,0,12" Padding="4"/>

            <TextBlock Text="Country:" Margin="0,0,0,4"/>
            <ComboBox Margin="0,0,0,12" Padding="4">
                <ComboBoxItem Content="Germany"/>
                <ComboBoxItem Content="Austria"/>
                <ComboBoxItem Content="Switzerland"/>
                <ComboBoxItem Content="United Kingdom"/>
                <ComboBoxItem Content="United States"/>
            </ComboBox>

            <CheckBox Content="Subscribe to the newsletter" Margin="0,4"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="90" Height="30" Margin="0,0,10,0"/>
            <Button Content="Register" Width="90" Height="30" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
