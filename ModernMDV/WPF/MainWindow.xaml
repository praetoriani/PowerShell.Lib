<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ModernMDV"
    Height="600" Width="800"
    MinHeight="400" MinWidth="600"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    x:Name="MainWindow">

    <Grid>
        <!-- Outer window frame with drop-shadow -->
        <Border CornerRadius="8" Background="#1C1C1C" Margin="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0"
                                  Color="#000000" Opacity="0.70"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>   <!-- TitleBar     -->
                    <RowDefinition Height="*"/>    <!-- Content      -->
                    <RowDefinition Height="24"/>   <!-- StatusBar    -->
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════
                     ROW 0 – TITLE BAR
                ══════════════════════════════════════════════ -->
                <Border x:Name="TitleBar"
                        Grid.Row="0"
                        Background="#111111"
                        CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: icon + title + version -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="10,0,0,0">
                            <Image x:Name="WindowIcon"
                                   Width="20" Height="20"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TitleText"
                                       Text="ModernMDV"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#EEEEEE" VerticalAlignment="Center"/>
                            <TextBlock Text="  " VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionText"
                                       Text="v1.00.00"
                                       FontSize="11" Foreground="#888888"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Center: current file name -->
                        <Label x:Name="FileNameLabel"
                               Grid.Column="1"
                               Content="No file loaded"
                               FontSize="12" Foreground="#AAAAAA"
                               Background="Transparent"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Padding="0"/>

                        <!-- Right: window action buttons
                             Visual order (left→right):
                             Settings | Help | Info | OpenFile | sep | Minimize | Maximize | Close -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,6,0">

                            <!-- Settings -->
                            <Label x:Name="BtnSettings" Width="24" Height="24"
                                   Padding="0" Background="Transparent" Cursor="Hand"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Margin="2,0,0,0" ToolTip="Settings">
                                <Image x:Name="BtnSettingsImage"
                                       Width="20" Height="20" Stretch="Uniform"/>
                            </Label>

                            <!-- Help -->
                            <Label x:Name="BtnHelp" Width="24" Height="24"
                                   Padding="0" Background="Transparent" Cursor="Hand"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Margin="2,0,0,0" ToolTip="Help">
                                <Image x:Name="BtnHelpImage"
                                       Width="20" Height="20" Stretch="Uniform"/>
                            </Label>

                            <!-- Info / About -->
                            <Label x:Name="BtnInfo" Width="24" Height="24"
                                   Padding="0" Background="Transparent" Cursor="Hand"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Margin="2,0,0,0" ToolTip="About ModernMDV">
                                <Image x:Name="BtnInfoImage"
                                       Width="20" Height="20" Stretch="Uniform"/>
                            </Label>

                            <!-- Open File -->
                            <Label x:Name="BtnOpenFile" Width="24" Height="24"
                                   Padding="0" Background="Transparent" Cursor="Hand"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Margin="2,0,0,0" ToolTip="Open Markdown File (Ctrl+O)">
                                <Image x:Name="BtnOpenFileImage"
                                       Width="20" Height="20" Stretch="Uniform"/>
                            </Label>

                            <!-- Separator -->
                            <Rectangle Width="1" Height="18" Fill="#444444"
                                       Margin="6,0,4,0" VerticalAlignment="Center"/>

                            <!-- Minimize -->
                            <Label x:Name="BtnMinimize" Width="24" Height="24"
                                   Padding="0" Background="Transparent" Cursor="Hand"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Margin="2,0,0,0" ToolTip="Minimize">
                                <Image x:Name="BtnMinimizeImage"
                                       Width="20" Height="20" Stretch="Uniform"/>
                            </Label>

                            <!-- Maximize / Restore -->
                            <Label x:Name="BtnMaximize" Width="24" Height="24"
                                   Padding="0" Background="Transparent" Cursor="Hand"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Margin="2,0,0,0" ToolTip="Maximize / Restore">
                                <Image x:Name="BtnMaximizeImage"
                                       Width="20" Height="20" Stretch="Uniform"/>
                            </Label>

                            <!-- Close -->
                            <Label x:Name="BtnClose" Width="24" Height="24"
                                   Padding="0" Background="Transparent" Cursor="Hand"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Margin="2,0,0,0" ToolTip="Close Application">
                                <Image x:Name="BtnCloseImage"
                                       Width="20" Height="20" Stretch="Uniform"/>
                            </Label>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════
                     ROW 1 – CONTENT AREA
                     Two-column split: 30 % left | 70 % right
                     + floating 20×20 toggle button (Z-axis overlay)
                ══════════════════════════════════════════════ -->
                <Grid Grid.Row="1">

                    <!-- Two columns -->
                    <Grid x:Name="ContentGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftColumn"  Width="3*"/>
                            <ColumnDefinition x:Name="RightColumn" Width="7*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── LEFT PANEL: Sitemap / TreeView ── -->
                        <Border x:Name="LeftPanel"
                                Grid.Column="0"
                                Background="#161616"
                                BorderBrush="#2A2A2A"
                                BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Sitemap header -->
                                <Border Grid.Row="0"
                                        Background="#1A1A2A"
                                        BorderBrush="#333355"
                                        BorderThickness="0,0,0,1"
                                        Padding="28,0,4,0">
                                    <TextBlock Text="SITEMAP"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#7788AA"
                                               VerticalAlignment="Center"
                                               CharacterSpacing="80"/>
                                </Border>

                                <!-- TreeView with dark-theme override -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <TreeView x:Name="SitemapTree"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="4,4,4,8">
                                        <TreeView.Resources>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="Background"   Value="Transparent"/>
                                                <Setter Property="Foreground"   Value="#AAAACC"/>
                                                <Setter Property="FontSize"     Value="12"/>
                                                <Setter Property="Padding"      Value="2,3,2,3"/>
                                                <Setter Property="Cursor"       Value="Hand"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#22334A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected"  Value="True">
                                                        <Setter Property="Background" Value="#1A3050"/>
                                                        <Setter Property="Foreground" Value="#DDEEFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TreeView.Resources>
                                    </TreeView>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- ── RIGHT PANEL: Markdown Viewer ── -->
                        <Border Grid.Column="1" Background="#1C1C1C">
                            <FlowDocumentScrollViewer
                                x:Name="DocViewer"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Background="#1C1C1C"
                                BorderThickness="0"
                                Padding="0">
                                <!-- Placeholder shown before any file is loaded -->
                                <FlowDocument x:Name="MainDocument"
                                              Background="#1C1C1C"
                                              FontFamily="Segoe UI"
                                              FontSize="14"
                                              Foreground="#888888"
                                              PagePadding="28,20,28,20">
                                    <Paragraph TextAlignment="Center" Margin="0,100,0,12">
                                        <Run FontSize="18" Foreground="#556677">
                                            No document loaded
                                        </Run>
                                    </Paragraph>
                                    <Paragraph TextAlignment="Center">
                                        <Run FontSize="13" Foreground="#445055">Click </Run>
                                        <Run FontSize="13" Foreground="#4488AA"
                                             FontWeight="SemiBold">Open File</Run>
                                        <Run FontSize="13" Foreground="#445055">
                                            in the title bar or press
                                        </Run>
                                        <Run FontSize="13" Foreground="#4488AA"
                                             FontWeight="SemiBold">Ctrl+O</Run>
                                        <Run FontSize="13" Foreground="#445055">
                                            to open a Markdown file.
                                        </Run>
                                    </Paragraph>
                                </FlowDocument>
                            </FlowDocumentScrollViewer>
                        </Border>

                    </Grid><!-- /ContentGrid -->

                    <!-- ── FLOATING TOGGLE BUTTON (Z-axis overlay) ──
                         Always visible; sits above both columns.
                         20×20 px per spec. Positioned top-left of content row. -->
                    <Button x:Name="TogglePanelButton"
                            Width="20" Height="20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,6,0,0"
                            Padding="0"
                            Foreground="#7788AA"
                            BorderThickness="1"
                            Cursor="Hand"
                            FontSize="11"
                            FontWeight="Bold"
                            ToolTip="Hide/Show Sitemap Panel"
                            Panel.ZIndex="100"
                            Content="&#x2039;">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"   Value="#1A1A2A"/>
                                <Setter Property="BorderBrush"  Value="#333355"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="0,4,4,0">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2A2A44"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#0A0A22"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                </Grid><!-- /content host grid -->

                <!-- ══════════════════════════════════════════════
                     ROW 2 – STATUS BAR
                ══════════════════════════════════════════════ -->
                <Border Grid.Row="2"
                        Background="#111111"
                        BorderBrush="#2A2A2A"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="StatusBarLabel"
                               Grid.Column="0"
                               Content="Ready"
                               FontSize="11" Foreground="#666666"
                               Background="Transparent"
                               Padding="8,0,0,0" VerticalAlignment="Center"/>
                        <Label Grid.Column="1"
                               Content="ModernMDV v1.00.00"
                               FontSize="10" Foreground="#444444"
                               Background="Transparent"
                               Padding="0,0,8,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>