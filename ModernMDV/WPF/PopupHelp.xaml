<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ModernMDV Help"
    Height="420" Width="560"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    x:Name="HelpWindow">

    <Grid>
        <Border CornerRadius="8" Background="#1C1C1C" Margin="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                  Color="#000000" Opacity="0.65"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>

                <Border x:Name="HelpTitleBar" Grid.Row="0"
                        Background="#111111" CornerRadius="8,8,0,0">
                    <Grid>
                        <TextBlock Text="Help — ModernMDV"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#EEEEEE"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <Label x:Name="HelpBtnClose"
                               HorizontalAlignment="Right"
                               Width="24" Height="24" Padding="0"
                               Background="Transparent" Cursor="Hand"
                               VerticalContentAlignment="Center"
                               HorizontalContentAlignment="Center"
                               Margin="0,0,8,0" ToolTip="Close">
                            <Image x:Name="HelpBtnCloseImage"
                                   Width="20" Height="20" Stretch="Uniform"/>
                        </Label>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,16,24,16">
                    <StackPanel>
                        <TextBlock Text="Keyboard Shortcuts"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#AABBDD" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + O"
                                       Foreground="#4488AA" FontSize="12"
                                       FontFamily="Consolas" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Open Markdown file"
                                       Foreground="#AAAAAA" FontSize="12" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + W"
                                       Foreground="#4488AA" FontSize="12"
                                       FontFamily="Consolas" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Close current file"
                                       Foreground="#AAAAAA" FontSize="12" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Alt + F4"
                                       Foreground="#4488AA" FontSize="12"
                                       FontFamily="Consolas" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Close application"
                                       Foreground="#AAAAAA" FontSize="12" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="F1"
                                       Foreground="#4488AA" FontSize="12"
                                       FontFamily="Consolas" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Show this help dialog"
                                       Foreground="#AAAAAA" FontSize="12" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + ,"
                                       Foreground="#4488AA" FontSize="12"
                                       FontFamily="Consolas" Margin="0,3,0,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Open Settings"
                                       Foreground="#AAAAAA" FontSize="12" Margin="0,3,0,3"/>
                        </Grid>

                        <TextBlock Text="Supported Markdown Elements"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#AABBDD" Margin="0,0,0,10"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12"
                                   LineHeight="20">
                            Headings (H1–H6) · Bold · Italic · Bold+Italic ·
                            Inline Code · Code Blocks · Blockquotes ·
                            Horizontal Rules · Ordered &amp; Unordered Lists ·
                            Tables (GFM) · Links · Paragraphs
                        </TextBlock>

                        <TextBlock Text="Sitemap Navigation"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#AABBDD" Margin="0,16,0,10"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#888899" FontSize="12"
                                   LineHeight="20">
                            After opening a file, all headings (H1–H4) are extracted and
                            displayed in the Sitemap panel on the left. Click any heading
                            to jump directly to that section in the document.
                            Use the ‹ toggle button to hide or show the Sitemap panel.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="#111111"
                        BorderBrush="#2A2A2A"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8">
                    <Button x:Name="HelpOkButton"
                            Content="OK"
                            Width="80" Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12" Foreground="#CCCCCC"
                            Background="#1A3050"
                            BorderBrush="#2A4070"
                            BorderThickness="1"
                            Cursor="Hand"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>