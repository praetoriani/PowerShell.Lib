<?xml version="1.0" encoding="utf-8"?>
<!--
    WinISO Image Mounter v1.00.00 — Main Window XAML Definition
    File:      data\ui\main.window.xml
    Purpose:   Defines the WPF UI for the WinISO Image Mounter application window.
               This file is loaded externally by WinIsoImageMounter.ps1 - no inline
               XAML is used anywhere in the PowerShell source (mandatory design rule,
               taken 1:1 from the PowerEdge App Development Guidelines).

    Design:    Modern dark-themed frameless window with a custom title bar
               (icon + title + close button only - no minimize/maximize),
               two labeled input rows with icon-buttons, and three action
               buttons. Color palette, corner radius, drop shadow and the
               traffic-light button template are taken 1:1 from the
               PowerEdge reference UI (data\ui\main.window.xml) so that
               this application shares the exact same visual identity.

    Author:    praetoriani
    Version:   1.00.02   Date: 18.08.2026
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinISO Image Mounter"
    Width="640"
    Height="340"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  COLOR PALETTE - copied 1:1 from PowerEdge (data\ui\main.window.xml) -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BrushBg"             Color="#121212"/>
        <SolidColorBrush x:Key="BrushSurface"        Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BrushSurface2"       Color="#1F1F1F"/>
        <SolidColorBrush x:Key="BrushTitleBar"       Color="#0F0F0F"/>
        <SolidColorBrush x:Key="BrushAccent"         Color="#2cec0e"/>
        <SolidColorBrush x:Key="BrushAccentHover"    Color="#43ff3d"/>
        <SolidColorBrush x:Key="BrushAccentDim"      Color="#19b90a"/>
        <SolidColorBrush x:Key="BrushText"           Color="#E8E8E8"/>
        <SolidColorBrush x:Key="BrushTextMuted"      Color="#888888"/>
        <SolidColorBrush x:Key="BrushTextFaint"      Color="#444444"/>
        <SolidColorBrush x:Key="BrushBorder"         Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrushBtnClose"       Color="#970f14"/>
        <SolidColorBrush x:Key="BrushBtnCloseHover"  Color="#c12025"/>
        <SolidColorBrush x:Key="BrushBtnMinimize"    Color="#F0A500"/>
        <SolidColorBrush x:Key="BrushBtnMaximize"    Color="#25A244"/>
        <SolidColorBrush x:Key="BrushTransparent"    Color="Transparent"/>

        <!-- Extra brushes needed for the input form (not present in PowerEdge,
             derived from the same palette so the look stays 100% consistent) -->
        <SolidColorBrush x:Key="BrushInputBg"        Color="#1F1F1F"/>
        <SolidColorBrush x:Key="BrushInputBorder"    Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrushInputError"     Color="#740509"/>
        <SolidColorBrush x:Key="BrushInputErrorBrdr" Color="#e4454a"/>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  WINDOW CONTROL BUTTON STYLE (Close only) - 1:1 from PowerEdge      -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="WinCtrlBtn" TargetType="Button">
            <Setter Property="Width"             Value="20"/>
            <Setter Property="Height"            Value="20"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Focusable"         Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="BtnEllipse" Fill="{TemplateBinding Background}" Width="17" Height="17"/>
                            <TextBlock x:Name="CloseGlyph" Text="×" FontSize="22" FontWeight="Bold"
                                    Foreground="#f1242e" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                                    Margin="0,-7,0,0" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseGlyph" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnEllipse" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  TEXT STYLES                                                        -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="StatusBarText" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InstructionText" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily"          Value="Segoe UI"/>
            <Setter Property="FontSize"            Value="16"/>
            <Setter Property="TextWrapping"        Value="Wrap"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily"        Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  INPUT TEXTBOX STYLE (rounded, dark surface, teal focus border)     -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background"            Value="{StaticResource BrushInputBg}"/>
            <Setter Property="Foreground"            Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush"            Value="{StaticResource BrushInputBorder}"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="8,6"/>
            <Setter Property="FontFamily"             Value="Segoe UI"/>
            <Setter Property="FontSize"               Value="15"/>
            <Setter Property="CaretBrush"             Value="{StaticResource BrushAccent}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush"         Value="{StaticResource BrushAccentDim}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  ICON BUTTON STYLE (Open / Browse) - vector glyph, no bitmap file   -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width"           Value="38"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="{StaticResource BrushInputBg}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BrushInputBorder}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Focusable"        Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBtnBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBtnBorder" Property="Background" Value="{StaticResource BrushAccentDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  ACTION BUTTON STYLE (Mount / Cancel / Exit)                        -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="MinWidth"         Value="104"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Background"       Value="{StaticResource BrushSurface2}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BrushBorder}"/>
            <Setter Property="Foreground"        Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily"        Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Focusable"          Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActBtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="18,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActBtnBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActBtnBorder" Property="Background" Value="{StaticResource BrushAccentDim}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}"/>
                                <Setter TargetName="ActBtnBorder" Property="Background" Value="{StaticResource BrushSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ╔════════════════════════════════════════════════════════════════════╗ -->
    <!--  OUTER WINDOW BORDER - rounded corners + drop shadow (1:1 PowerEdge) -->
    <!-- ╚════════════════════════════════════════════════════════════════════╝ -->
    <Border CornerRadius="10"
            Background="{StaticResource BrushBg}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                               BlurRadius="32"
                               ShadowDepth="8"
                               Opacity="0.6"
                               Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>  <!-- Custom title bar     -->
                <RowDefinition Height="*"/>   <!-- Form content area    -->
                <RowDefinition Height="26"/>  <!-- Status bar           -->
            </Grid.RowDefinitions>

            <!-- ──────────────────────────────────────────────────────────── -->
            <!--  ROW 0 - CUSTOM TITLE BAR (icon + title + close button only) -->
            <!-- ──────────────────────────────────────────────────────────── -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{StaticResource BrushTitleBar}"
                    CornerRadius="10,10,0,0">

                <Grid x:Name="TitleBarPanel"
                      Background="Transparent"
                      Cursor="Arrow">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- App icon              -->
                        <ColumnDefinition Width="*"/>     <!-- Title text (centered) -->
                        <ColumnDefinition Width="Auto"/>  <!-- Close button only     -->
                    </Grid.ColumnDefinitions>

                    <!-- App icon -->
                    <Image x:Name="TitleBarLogo"
                           Grid.Column="0"
                           Width="20" Height="20"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Centered window title (dynamic - set from PowerShell/JSON) -->
                    <TextBlock x:Name="TitleBarText"
                               Grid.Column="1"
                               Text="WinISO Image Mounter"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <!-- Close button only - no minimize/maximize -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">

                        <Button x:Name="BtnClose"
                                Style="{StaticResource WinCtrlBtn}"
                                Background="{StaticResource BrushBtnClose}"
                                ToolTip="Close"/>

                    </StackPanel>

                </Grid>
            </Border>

            <Rectangle Grid.Row="0"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{StaticResource BrushBorder}"/>

            <!-- ──────────────────────────────────────────────────────────── -->
            <!--  ROW 1 - FORM CONTENT AREA                                   -->
            <!-- ──────────────────────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="24,20,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Instruction text -->
                    <RowDefinition Height="20"/>   <!-- Spacer           -->
                    <RowDefinition Height="Auto"/> <!-- Image file row   -->
                    <RowDefinition Height="14"/>   <!-- Spacer           -->
                    <RowDefinition Height="Auto"/> <!-- Mount point row  -->
                    <RowDefinition Height="*"/>    <!-- Flexible spacer  -->
                    <RowDefinition Height="Auto"/> <!-- Action buttons   -->
                </Grid.RowDefinitions>

                <!-- Instruction text -->
                <TextBlock x:Name="LblInstructions"
                           Grid.Row="0"
                           Style="{StaticResource InstructionText}"
                           Text="Please specify a Windows Image (*.wim) file and define a directory into which the image content should be mounted."/>

                <!-- Image file row -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LblImageFile"
                               Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Image File:"/>

                    <TextBox x:Name="TxtImageFile"
                             Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Margin="0,0,8,0"/>

                    <Button x:Name="BtnOpenImage"
                            Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            ToolTip="Open">
                        <!-- Vector "Disc" glyph - placeholder for a future bitmap icon -->
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="22" Height="22" Fill="{StaticResource BrushAccent}"/>
                                <Ellipse Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5" Fill="{StaticResource BrushSurface2}"/>
                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="22" Height="22" Stroke="{StaticResource BrushSurface2}" StrokeThickness="0.8"/>
                                <Path Data="M4,7 A10,10 0 0,1 15,3" Stroke="{StaticResource BrushSurface2}" StrokeThickness="1.4" Opacity="0.55"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- Mount point row -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LblMountPoint"
                               Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Mount Point:"/>

                    <TextBox x:Name="TxtMountPoint"
                             Grid.Column="1"
                             Style="{StaticResource InputBox}"
                             Margin="0,0,8,0"/>

                    <Button x:Name="BtnBrowseMount"
                            Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            ToolTip="Browse">
                        <!-- Vector "folder-open" glyph - placeholder for a future bitmap icon -->
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.9 21.1,6 20,6Z"
                                      Fill="{StaticResource BrushAccent}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- Action buttons -->
                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button x:Name="BtnMount"
                            Style="{StaticResource ActionButton}"
                            Content="Mount"
                            Margin="0,0,40,0"/>

                    <Button x:Name="BtnCancel"
                            Style="{StaticResource ActionButton}"
                            Content="Cancel"
                            Margin="0,0,40,0"/>

                    <Button x:Name="BtnExit"
                            Style="{StaticResource ActionButton}"
                            Content="Exit"/>

                </StackPanel>

            </Grid>

            <!-- ──────────────────────────────────────────────────────────── -->
            <!--  ROW 2 - STATUS BAR                                          -->
            <!-- ──────────────────────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushTitleBar}"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0">

                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Text="Ready"
                               Style="{StaticResource StatusBarText}"/>

                    <TextBlock Grid.Column="1"
                               Text="WinISO Image Mounter v1.00.00"
                               Style="{StaticResource StatusBarText}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
