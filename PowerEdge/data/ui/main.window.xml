<?xml version="1.0" encoding="utf-8"?>
<!--
    PowerEdge v1.00.02 — Main Window XAML Definition
    ─────────────────────────────────────────────────────────────────────
    File:      .gui\main.window.xml
    Purpose:   Defines the WPF UI for the PowerEdge application window.
               This file is loaded externally by PowerEdge.ps1 as per the
               mandatory App Development Guidelines (no inline XAML).

    Design:    Modern dark-themed frameless window with a custom title bar,
               WebView2 host area, and a minimal status bar.
               Color palette: deep charcoal surfaces, electric teal accent,
               clean white typography — professional and unobtrusive.

    Author:    Praetoriani
    Version:   1.00.02
    Date:      14.04.2026

    CHANGES v1.00.02:
      - Removed Typography.CharacterSpacing from the logo TextBlock.
        This attached property is not reliably supported on TextBlock
        elements when loaded via XamlReader.Load() under PowerShell 5.1
        / .NET Framework 4.x. Removed entirely; visual impact at 13px
        font size is negligible.
    ─────────────────────────────────────────────────────────────────────
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="PowerEdge"
    Width="1280"
    Height="800"
    MinWidth="800"
    MinHeight="500"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  COLOR PALETTE                                                  -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BrushBg"             Color="#121212"/>
        <SolidColorBrush x:Key="BrushSurface"        Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BrushSurface2"       Color="#1F1F1F"/>
        <SolidColorBrush x:Key="BrushTitleBar"       Color="#0F0F0F"/>
        <SolidColorBrush x:Key="BrushAccent"         Color="#00B4C8"/>
        <SolidColorBrush x:Key="BrushAccentHover"    Color="#00D4E8"/>
        <SolidColorBrush x:Key="BrushAccentDim"      Color="#00697A"/>
        <SolidColorBrush x:Key="BrushText"           Color="#E8E8E8"/>
        <SolidColorBrush x:Key="BrushTextMuted"      Color="#888888"/>
        <SolidColorBrush x:Key="BrushTextFaint"      Color="#444444"/>
        <SolidColorBrush x:Key="BrushBorder"         Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BrushBtnClose"       Color="#E05055"/>
        <SolidColorBrush x:Key="BrushBtnCloseHover"  Color="#FF6B70"/>
        <SolidColorBrush x:Key="BrushBtnMinimize"    Color="#F0A500"/>
        <SolidColorBrush x:Key="BrushBtnMaximize"    Color="#25A244"/>
        <SolidColorBrush x:Key="BrushTransparent"    Color="Transparent"/>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  WINDOW CONTROL BUTTON STYLE (Close / Minimize / Maximize)     -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="WinCtrlBtn" TargetType="Button">
            <Setter Property="Width"             Value="14"/>
            <Setter Property="Height"            Value="14"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Focusable"         Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="BtnEllipse"
                                 Fill="{TemplateBinding Background}"
                                 Width="14" Height="14">
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnEllipse" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnEllipse" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!--  STATUS BAR TEXT STYLE                                          -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="StatusBarText" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- ╔════════════════════════════════════════════════════════════════════╗ -->
    <!--  OUTER WINDOW BORDER — provides rounded corners + drop shadow       -->
    <!-- ╚════════════════════════════════════════════════════════════════════╝ -->
    <Border CornerRadius="10"
            Background="{StaticResource BrushBg}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="32"
                              ShadowDepth="8"
                              Opacity="0.6"
                              Direction="270"/>
        </Border.Effect>

        <!-- Main layout: TitleBar (top) + Content (center) + StatusBar (bottom) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>    <!-- Custom title bar           -->
                <RowDefinition Height="*"/>     <!-- WebView2 content area      -->
                <RowDefinition Height="24"/>    <!-- Status bar                 -->
            </Grid.RowDefinitions>

            <!-- ──────────────────────────────────────────────────────────────── -->
            <!--  ROW 0 — CUSTOM TITLE BAR                                   -->
            <!-- ──────────────────────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushTitleBar}"
                    CornerRadius="10,10,0,0">

                <Grid x:Name="TitleBarPanel"
                      Cursor="SizeAll">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- App logo area          -->
                        <ColumnDefinition Width="*"/>     <!-- Title text (centered)  -->
                        <ColumnDefinition Width="Auto"/>  <!-- Window control buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Logo / brand mark area -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">

<!-- App logo icon (source set dynamically in PowerEdge.ps1) -->
                        <Image x:Name="TitleBarLogo"
                               Width="20" Height="20"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="PowerEdge"
                                   Foreground="{StaticResource BrushText}"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Centered window title (dynamic — set from PowerShell) -->
                    <TextBlock x:Name="TitleBarText"
                               Grid.Column="1"
                               Text="PowerEdge"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="Normal"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- macOS-style traffic light window control buttons     -->
                    <!-- Note: StackPanel.Spacing is WinUI3-only; use Margin  -->
                    <!-- on individual buttons instead (WPF-compatible).      -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">

                        <!-- Minimize -->
                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource WinCtrlBtn}"
                                Background="{StaticResource BrushBtnMinimize}"
                                ToolTip="Minimize"/>

                        <!-- Maximize / Restore -->
                        <Button x:Name="BtnMaximize"
                                Style="{StaticResource WinCtrlBtn}"
                                Background="{StaticResource BrushBtnMaximize}"
                                ToolTip="Maximize / Restore"
                                Margin="8,0,0,0"/>

                        <!-- Close -->
                        <Button x:Name="BtnClose"
                                Style="{StaticResource WinCtrlBtn}"
                                Background="{StaticResource BrushBtnClose}"
                                ToolTip="Close"
                                Margin="8,0,0,0"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ──────────────────────────────────────────────────────────────── -->
            <!--  SEPARATOR LINE between title bar and content               -->
            <!-- ──────────────────────────────────────────────────────────────── -->
            <Rectangle Grid.Row="0"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{StaticResource BrushBorder}"/>

            <!-- ──────────────────────────────────────────────────────────────── -->
            <!--  ROW 1 — WEBVIEW2 CONTENT AREA                              -->
            <!-- ──────────────────────────────────────────────────────────────── -->
            <Grid Grid.Row="1">

                <!-- The Microsoft Edge WebView2 control — primary content host -->
                <wv2:WebView2 x:Name="MainWebView"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>

                <!-- Loading overlay — shown while WebView2 initializes -->
                <Border x:Name="LoadingOverlay"
                        Background="{StaticResource BrushBg}"
                        Visibility="Visible">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <!-- Animated accent spinner (CSS-style dot ring) -->
                        <Ellipse Width="48"
                                 Height="48"
                                 Stroke="{StaticResource BrushAccent}"
                                 StrokeThickness="3"
                                 StrokeDashArray="10 5"
                                 HorizontalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" CenterX="24" CenterY="24"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="SpinnerRotate"
                                                Storyboard.TargetProperty="Angle"
                                                From="0" To="360"
                                                Duration="0:0:1.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <TextBlock Text="Initializing Edge WebView2..."
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>

                        <TextBlock Text="Powered by Microsoft Edge"
                                   Foreground="{StaticResource BrushTextFaint}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                    </StackPanel>
                </Border>

            </Grid>

            <!-- ──────────────────────────────────────────────────────────────── -->
            <!--  ROW 2 — STATUS BAR                                         -->
            <!-- ──────────────────────────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushTitleBar}"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0">

                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: dynamic status message -->
                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Text="Initializing..."
                               Style="{StaticResource StatusBarText}"/>

                    <!-- Right: version label -->
                    <TextBlock Grid.Column="1"
                               Text="PowerEdge v1.00.02"
                               Style="{StaticResource StatusBarText}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
