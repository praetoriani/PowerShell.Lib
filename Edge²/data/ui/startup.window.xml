<?xml version="1.0" encoding="utf-8"?>
<!--
    PowerEdge v1.00.02 — Startup / SplashScreen Window XAML Definition
    ─────────────────────────────────────────────────────────────────────
    File:     data\ui\startup.window.xml
    Purpose:  Defines the WPF SplashScreen UI that is shown while
              PowerEdge is running in -Hidden mode (before the main
              window becomes visible).
              This window is launched as an INDEPENDENT process so
              that it is visible even though the main WPF window is
              hidden during startup.
    Design:   Identical look & feel as main.window.xml:
              deep charcoal surface, electric teal accent,
              clean white typography, rounded corners, drop-shadow.
              The window has NO title bar, NO resize grip, NO close
              button — it cannot be moved, minimized or maximized.
              It is purely informational (SplashScreen behaviour).
    Author:   Praetoriani
    Version:  1.00.02    Date: 14.04.2026
    ─────────────────────────────────────────────────────────────────────
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PowerEdge"
    Width="460"
    Height="220"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- COLOR PALETTE  (identical to main.window.xml)                      -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="BrushBg"          Color="#121212"/>
        <SolidColorBrush x:Key="BrushSurface"     Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BrushTitleBar"    Color="#0F0F0F"/>
        <SolidColorBrush x:Key="BrushAccent"      Color="#00B4C8"/>
        <SolidColorBrush x:Key="BrushAccentDim"   Color="#00697A"/>
        <SolidColorBrush x:Key="BrushText"        Color="#E8E8E8"/>
        <SolidColorBrush x:Key="BrushTextMuted"   Color="#888888"/>
        <SolidColorBrush x:Key="BrushTextFaint"   Color="#444444"/>
        <SolidColorBrush x:Key="BrushBorder"      Color="#2A2A2A"/>
    </Window.Resources>

    <!-- ╔════════════════════════════════════════════════════════════════════╗ -->
    <!-- OUTER BORDER — rounded corners + drop shadow (same as main window)  -->
    <!-- ╚════════════════════════════════════════════════════════════════════╝ -->
    <Border CornerRadius="10"
            Background="{StaticResource BrushBg}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="32"
                              ShadowDepth="8"
                              Opacity="0.6"
                              Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>  <!-- Mini title bar (logo only, no buttons) -->
                <RowDefinition Height="*"/>   <!-- Message area -->
                <RowDefinition Height="30"/>  <!-- Bottom accent bar -->
            </Grid.RowDefinitions>

            <!-- ────────────────────────────────────────────────────────── -->
            <!-- ROW 0 — MINI TITLE BAR (logo + brand text, no controls)   -->
            <!-- ────────────────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushTitleBar}"
                    CornerRadius="10,10,0,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <!-- App logo icon (source set dynamically in PowerShell) -->
                    <Image x:Name="SplashLogo"
                           Width="26" Height="26"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Power"
                               Foreground="{StaticResource BrushText}"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <TextBlock Text="Edge"
                               Foreground="#90e30c"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Separator line between title bar and content -->
            <Rectangle Grid.Row="0"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{StaticResource BrushBorder}"/>

            <!-- ────────────────────────────────────────────────────────── -->
            <!-- ROW 1 — MESSAGE AREA                                       -->
            <!-- ────────────────────────────────────────────────────────── -->
            <Grid Grid.Row="1" Background="{StaticResource BrushBg}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Animated accent spinner (same design as LoadingOverlay in main window) -->
                    <Ellipse Width="36"
                             Height="36"
                             Stroke="{StaticResource BrushAccent}"
                             StrokeThickness="3"
                             StrokeDashArray="10 5"
                             HorizontalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SplashSpinnerRotate" CenterX="18" CenterY="18"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="SplashSpinnerRotate"
                                            Storyboard.TargetProperty="Angle"
                                            From="0" To="360"
                                            Duration="0:0:1.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <!-- Primary message -->
                    <TextBlock x:Name="SplashMessage"
                               Text="Bitte warten. Programm wird geladen"
                               Foreground="{StaticResource BrushText}"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"/>

                    <!-- Secondary hint -->
                    <TextBlock Text="Powered by Microsoft Edge"
                               Foreground="{StaticResource BrushTextFaint}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ────────────────────────────────────────────────────────── -->
            <!-- ROW 2 — BOTTOM ACCENT / STATUS BAR                         -->
            <!-- ────────────────────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushTitleBar}"
                    CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SplashStatusText"
                               Grid.Column="0"
                               Text="Initialisierung..."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="PowerEdge v1.00.02"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
